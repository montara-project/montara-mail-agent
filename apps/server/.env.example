# App
# Debug logging prints every auth query with its values, password hashes
# included; it is refused when ENV=production.
DEBUG=false
# development, staging or production. Unset means production; only
# development relaxes the session cookie and the loopback rate limit.
ENV=development
PORT=8080
APP_NAME=montara-mail-agent
APP_SECRET=

# Super user created on boot when SEED_ON_BOOT=true, as email:password.
# The password must be 12 to 128 characters, so replace this one. Changing it
# resets the account's password on the next seeded boot.
SUPER_USER=admin@mail.com:admin123

# Comma-separated browser origins allowed to call the API cross-origin.
# Empty disables CORS (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated IPs/CIDRs of the reverse proxy allowed to set
# X-Forwarded-For. Empty trusts no proxy: the client IP is the peer address.
TRUSTED_PROXIES=
# Comma-separated client IPs exempt from the rate limiter.
RATE_LIMIT_EXEMPT_IPS=

# Directory of a built single-page app served at / by the API (the
# fullstack image sets /app/web). Empty disables it.
SPA_DIR=

# Apply embedded migrations when the API boots
MIGRATE_ON_BOOT=true
# Run the idempotent seeders when the API boots (needs SUPER_USER). Required
# by the Community Edition (EDITION=community at build time), whose only
# account is the super user.
SEED_ON_BOOT=false

DB_DSN=postgres://postgres:postgres@localhost:5432/montara_mail_agent?sslmode=disable
# Per replica, split in half between the API pool and Authula's.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Auth (Authula, mounted at /api/v1/auth). APP_SECRET also signs Authula tokens.
# Public URL of this API, used in email links and the Google callback;
# empty defaults to http://localhost:$PORT.
AUTH_BASE_URL=http://localhost:8080
# Resend sender (must be a verified domain) and API key. Required by the Cloud
# Edition; the Community Edition may leave both empty, which turns off password
# reset and magic-link sign-in (change SUPER_USER to reset the password).
FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
# Google OAuth client; empty disables Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/api/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fallback Anthropic API key for organizations without their own LLM provider
# (empty: those organizations get no AI features)
ANTHROPIC_API_KEY=

# OAuth clients that connect mailboxes; empty disables that provider's OAuth
# sign-in (its app password way in keeps working). iCloud and Lark offer no
# public IMAP OAuth, so they have no entry. Authorized redirect URI for each:
# $AUTH_BASE_URL/api/v1/email-accounts/oauth/<provider>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

OAUTH_YAHOO_CLIENT_ID=
OAUTH_YAHOO_CLIENT_SECRET=

OAUTH_ZOHO_CLIENT_ID=
OAUTH_ZOHO_CLIENT_SECRET=

# How often connected mailboxes are synced (0 disables the background sync)
MAIL_SYNC_INTERVAL=5m
# Let IMAP servers and LLM base URLs reach loopback/private addresses and use
# http, e.g. a local Ollama. Keep false when users you don't trust sign up.
ALLOW_PRIVATE_HOSTS=false

# How long activity log entries are kept (they carry IPs and mail subjects);
# a daily sweep deletes the older ones. 0 keeps them forever.
ACTIVITY_LOG_RETENTION=8760h

SENTRY_DSN=
