{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The docs are a static export (next build → out/), served by Workers static
  // assets alone: no Worker script runs.
  "name": "montaramail-docs",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./out",
    // /self-hosting serves out/self-hosting.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "docs.montaramail.web.id", "custom_domain": true }],
}
