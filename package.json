{
  "name": "montara-mail-agent",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:main-web": "pnpm --filter @montara-mail/main-web dev",
    "dev:web-ui": "pnpm --filter @montara-mail/web-ui dev",
    "dev:server": "pnpm --filter @montara-mail/server dev",
    "dev:docs": "pnpm --filter @montara-mail/docs dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "deploy:main-web": "pnpm --filter @montara-mail/main-web run deploy",
    "deploy:docs": "pnpm --filter @montara-mail/docs build && pnpm --filter @montara-mail/docs run deploy",
    "release": "release-it",
    "release:prepare": "release-it --ci --no-git.tag --no-git.push --no-github.release",
    "release:publish": "release-it --ci --no-increment --no-git.commit --no-git.push --github.release",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@release-it/conventional-changelog": "12.0.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "release-it": "21.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0"
}
