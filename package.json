{
  "name": "montara-mail-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:main-web": "pnpm --filter @montara-mail/main-web dev",
    "dev:web-ui": "pnpm --filter @montara-mail/web-ui dev",
    "dev:server": "pnpm --filter @montara-mail/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "deploy:main-web": "pnpm --filter @montara-mail/main-web run deploy",
    "release": "release-it",
    "release:prepare": "release-it --ci --no-git.tag --no-git.push --no-github.release",
    "release:publish": "release-it --ci --no-increment --no-git.commit --no-git.push --github.release"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "release-it": "21.1.1"
  }
}
